rec
    pub data ADT = {
        name: String,
        params: List Expr,
        constructors: List ADTCons
    }

    pub data ADTCons = {
        id: Int,
        name: String,
        args: List Expr
    }

    pub data Expr =
        | Var of String
        | Str of String
        | Integer of Int
        | Arr of String, Expr
        | App of Expr, Expr
        | Let of String, Expr, Expr
        | EADT of ADT, Expr

end
