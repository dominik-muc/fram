import open Type
import open Utils
import open FramParser/Expr
import open Env
import open TypedTree
import List
import UVar

implicit ~env: Env

let rec unify (t0: Type) (t1: Type) =
    match t0.view, t1.view with
    | TUVar u0, TUVar u1 =>
        if u0.id != u1.id
        then t0.setUvar t1
    | TUVar u, _ =>
        if not (t1.containsUvar u.id)
        then t0.setUvar t1
        else runtimeError "Unification failure 1"
    | _, TUVar u =>
        if not (t0.containsUvar u.id)
        then t1.setUvar t0
        else runtimeError "Unification failure 2"
    | TVar t0, TVar t1 =>
        if t0.id == t1.id then () else runtimeError "Unification failure 3"
    | TArr t0 t1, TArr t0' t1' =>
        unify t0 t0';
        unify t1 t1'
    | TInt, TInt => ()
    | TStr, TStr => ()
    | _, _ => runtimeError "Unification failure 4"
    end

rec
    pub let inferType {~env: Env} expr =
        match expr with
        | Integer i => (TypedExpr { expr = CInteger i, tp = tInt.toScm}, tInt)
        | Str     s => (TypedExpr { expr = CStr s, tp = tStr.toScm}, tStr)
        | Var x =>
            match ~env.getType x with
            | Some scm =>
                let sub = scm.tvars.toList.map (fn id => (id, freshUvar ())) in
                (TypedExpr { expr = CVar x, tp = scm }, scm.tp.withSub sub) 
            | None => runtimeError ("Unbound var: " + x)
            end
        | Arr v e =>
            let t0 = freshUvar () in
            let ~env = ~env.addType v t0.toScm in
            let (e1, t1) = inferType e in
            (TypedExpr { expr = CArr v e1, tp = (tArr t0 t1).toScm}, tArr t0 t1)
        | App e0 e1 =>
            let (te0, t0) = inferType e0 in
            let (te1, t1) = inferType e1 in
            let tx = freshUvar () in
            unify t0 (tArr t1 tx);
            (TypedExpr {expr = CApp te0 te1, tp = tx.toScm}, tx)
        | Let x e0 e1 =>
            let (tex, ~env) = checkLet x e0 in
            let (te1, t1) = inferType e1 in
            (TypedExpr { expr = CLet x tex te1, tp = t1.toScm}, t1)
        | _ => runtimeError "not implemented"
        end

    let checkLet {~env : Env} x e =
        let outEnv = ~env in
        let ~env = ~env.addLevel in
        let (tex, tx) = inferType e in
        (tex, outEnv.addType x tx.generalize)

    let checkType {~env : Env} expr tp =
        let (_, tp') = inferType expr in
        unify tp tp'
end
