import Map
import open Utils
import open Type
import open FramParser/Expr
import List

pub let Map.Map {module StrMap} = Map.make (compare {T=String})

pub data Env = {
    varMap : StrMap.T Scheme,
    level : Int
}

implicit ~env: Env

pub method addType {self: Env} v t =
    Env {
        varMap = self.varMap.insert v t,
        level = self.level
    }

pub method getType {self: Env} = self.varMap.find

pub method addLevel {self: Env} = 
    Env {
        varMap = self.varMap,
        level = self.level + 1
    }

let coerceType f expr =
    match expr with
    | Var x => f x
    | App x y => 
    | _ => runtimeError "makeFun"
    end

let makeFun (args: List Expr) (dt : ADT) =
    let typ = tDT dt.name (dt.params.map (coerceType tNamed))
    in
    args.foldLeft (fn acc arg => tArr (coerceType tNamed arg) acc) typ

pub method registerDatatype {self: Env} dt =
    let ADT {name, params, constructors} = dt in
    let tvars = Map.empty in
    
    constructors.foldLeft (fn (acc: Env) cons =>
        match cons with
        | ADTCons {id, name, args} =>
            acc.addType name (makeFun args tvars).generalize
        end)
    self