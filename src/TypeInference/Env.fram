import Map
import open Type
import open FramParser/Expr
import List
import open Utils

pub let Map.Map {module StrMap} = Map.make (compare {T=String})

pub data Env = {
    varMap : StrMap.T Scheme,
    level : Int
}

implicit ~env: Env

pub method addType {self: Env} v t =
    Env {
        varMap = self.varMap.insert v t,
        level = self.level
    }

pub method getType {self: Env} = self.varMap.find

pub method addLevel {self: Env} = 
    Env {
        varMap = self.varMap,
        level = self.level + 1
    }

pub let makeFun (args: List Expr) (dt: ADT) =
    {# Create fresh substitution for each of ADT's param #}
    let uvars = dt.params.rev.map (fn p =>
        match p with
        | Var x => (x, freshUvar ())
        | _ => runtimeError "makefun"
        end)
    in
    {# Create the resulting ADT type of fully applied constructor #}
    let tp_list = dt.params.rev.map (fn p => match p with
        | Var x =>
            match uvars.assoc {A=String} x with
            | Some tp => tp
            | None => runtimeError "unbound tvar"
            end
        | _ => runtimeError "makefun"
        end)
    in
    let adt_type = tDT dt.name tp_list in
    {# Fold argument list to a function, susbstituting ADT params for fresh uvars #}
    args.rev.foldLeft (fn acc (arg: Expr) =>
        match arg with
        | Var x => tArr (
            match uvars.assoc {A=String} x with
            | Some tp => tp
            | None => runtimeError "unbound tvar"
            end) acc
        | App (Var x) (Var y) =>
            tArr (
            match uvars.assoc {A=String} y with
            | Some tp => tDT x [tp]
            | None => runtimeError "unbound tvar"
            end) acc
        | _ => runtimeError "makefun"
        end
        ) adt_type


pub method registerDatatype {self: Env} (dt: ADT) =
    dt.constructors.foldLeft (fn (acc: Env) cons =>
        match cons with
        | ADTCons {id, name, args} =>
            let scm = (makeFun args dt).generalize in
            acc.addType name scm
        end)
    self