{# Result of type inference. #}

import TypeInference/Type

rec
pub data Expr =
    | CVar of String
    | CStr of String
    | CInteger of Int
    | CArr of String, TypedExpr
    | CApp of TypedExpr, TypedExpr
    | CLet of String, TypedExpr, TypedExpr
    | CMatch of TypedExpr, List TypedClause

pub data TypedClause = {
    pattern: TypedExpr,
    value: TypedExpr
}

pub data TypedExpr =
    { expr : Expr
    , tp : Type.Scheme
    }

end
