
import open FramParser/Expr
import TypeInference/TypeInference
import open TypeInference/Env
import Lang/TypeErase
import Eval/Eval
import open Utils

let ~env = Env { varMap = StrMap.empty, level = 0 }

pub let commonPipeline (prog: Expr) =
    prog
    |> TypeInference.tr_prog
    |> TypeErase.tr_prog
    |> Eval.eval_prog
    |> (fn x => x.toString)
    |> printStrLn

    
pub let typePipeline (prog: Expr) =
    prog
    |> TypeInference.tr_prog
    |> (fn (_, tp) => tp.toString)
    |> printStrLn


